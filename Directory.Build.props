<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Nullable analysis stays ON and still reports warnings, but does not fail the build.
      Real compile errors and every other warning category still break CI.
    -->
    <WarningsNotAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629;CS8632;NU1603;NU1604;NU1701;NU5104</WarningsNotAsErrors>

    <!--
      NuGet warnings are included above deliberately. The service references a
      PRERELEASE package (System.IO.Pipes.AccessControl 6.0.0-preview), and NuGet
      raises NU5104 for prerelease dependencies. With TreatWarningsAsErrors on,
      that warning alone would fail CI for a reason that has nothing to do with
      the code. See docs/BuildNotes.md.
    -->
  </PropertyGroup>
</Project>
