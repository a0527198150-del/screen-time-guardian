{
  "manifest_version": 3,
  "key": "",
  "name": "שומר זמן מסך",
  "description": "זיהוי חשבון Google, גילוי אתרים שנכנסים אליהם דרך Google, ואכיפת לוח זמנים",
  "version": "0.4.6",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://*.google.com/*",
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://gemini.google.com/*",
    "https://maps.google.com/*",
    "https://translate.google.com/*",
    "https://keep.google.com/*",
    "https://news.google.com/*",
    "https://groups.google.com/*",
    "https://one.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/*",
        "https://*.youtube.com/*",
        "https://youtube.com/*",
        "https://gemini.google.com/*",
        "https://maps.google.com/*",
        "https://translate.google.com/*",
        "https://keep.google.com/*",
        "https://news.google.com/*",
        "https://groups.google.com/*",
        "https://one.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "שומר זמן מסך"
  },
  "incognito": "spanning",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
