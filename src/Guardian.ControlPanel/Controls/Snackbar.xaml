<UserControl x:Class="ScreenTimeGuardian.ControlPanel.Snackbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             IsHitTestVisible="False"
             HorizontalAlignment="Center"
             VerticalAlignment="Bottom"
             Margin="0,0,0,24"
             Opacity="0">

    <Border x:Name="Bar" Background="{StaticResource BrushInk}" CornerRadius="8"
            Padding="20,12" MinWidth="300"
            Effect="{StaticResource ShadowCard}">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="MessageText" Style="{StaticResource TypeBody}"
                       Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="UndoButton" Content="ביטול" Style="{StaticResource ButtonGhost}"
                    Foreground="{StaticResource BrushTeal}" Height="32" Padding="12,0"
                    Visibility="Collapsed" Click="UndoButton_Click" />
        </StackPanel>
    </Border>
</UserControl>
