<UserControl x:Class="ScreenTimeGuardian.ControlPanel.StatusDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="Dot" Width="10" Height="10"
                 Fill="{StaticResource BrushTeal}"
                 VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="Label" Style="{StaticResource TypeBody}"
                   Foreground="{StaticResource BrushInkMuted}"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
