<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel">

    <!-- ==================== COLOR TOKENS ==================== -->
    <SolidColorBrush x:Key="Ink" Color="#1A1A2E" />
    <SolidColorBrush x:Key="MutedInk" Color="#64748B" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderLine" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderFocus" Color="#0EA5E9" />
    <SolidColorBrush x:Key="Teal" Color="#0D9488" />
    <SolidColorBrush x:Key="TealDark" Color="#0F766E" />
    <SolidColorBrush x:Key="TealLight" Color="#CCFBF1" />
    <SolidColorBrush x:Key="Indigo" Color="#1E3A5F" />
    <SolidColorBrush x:Key="Mist" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ErrorRed" Color="#DC2626" />
    <SolidColorBrush x:Key="SuccessGreen" Color="#16A34A" />
    <SolidColorBrush x:Key="WarningAmber" Color="#D97706" />
    <SolidColorBrush x:Key="SidebarBg" Color="#0F172A" />
    <SolidColorBrush x:Key="SidebarText" Color="#94A3B8" />
    <SolidColorBrush x:Key="SidebarActive" Color="#0D9488" />
    <SolidColorBrush x:Key="WeekBlocked" Color="#0D9488" />
    <SolidColorBrush x:Key="WeekFree" Color="#F1F5F9" />

    <!-- ==================== SHADOW EFFECTS ==================== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.06" />
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="6" ShadowDepth="1" Direction="270"
                      Color="#000000" Opacity="0.08" />
    <DropShadowEffect x:Key="LiftShadow" BlurRadius="16" ShadowDepth="4" Direction="270"
                      Color="#0D9488" Opacity="0.12" />

    <!-- ==================== BASE STYLES ==================== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,3,6,3" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="BorderBrush" Value="#94A3B8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource Teal}" />
        <Setter Property="BorderBrush" Value="{StaticResource TealDark}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TealDark}" />
                <Setter Property="BorderBrush" Value="#115E59" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#115E59" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource ErrorRed}" />
        <Setter Property="BorderBrush" Value="#B91C1C" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B91C1C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== INPUT STYLES ==================== -->
    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderFocus}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderFocus}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- ==================== TAB CONTROL ==================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Width" Value="0" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SidebarText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Assistant, Segoe UI, Arial" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Teal}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== WEEK GRID ==================== -->
    <Style x:Key="WeekGridCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <Style TargetType="local:WeekGrid">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- ==================== CARD STYLES ==================== -->
    <Style x:Key="StatusCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <Style x:Key="ActiveCard" TargetType="Border">
        <Setter Property="Background" Value="#ECFDF5" />
        <Setter Property="BorderBrush" Value="#0D9488" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect" Value="{StaticResource LiftShadow}" />
    </Style>
</ResourceDictionary>
