<Window x:Class="ScreenTimeGuardian.ControlPanel.RuleWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel"
        Title="אשף יצירת כלל" Width="680" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        Opacity="0.95"
        RenderTransformOrigin="0.5,0.5">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.95" To="1" Duration="0:0:0.12" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1" KeySpline="{StaticResource EaseOutStrong}" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1" KeySpline="{StaticResource EaseOutStrong}" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.RenderTransform>
        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
    </Window.RenderTransform>

    <Grid>
        <!-- Dark overlay -->
        <Border Background="#66000000" MouseLeftButtonDown="Overlay_Click" />

        <!-- Dialog -->
        <Border Background="{StaticResource BrushSurface}" CornerRadius="12"
                Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="640" MinHeight="540">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270"
                                  Opacity="0.14" Color="#141B2E" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Progress indicator -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Ellipse x:Name="Step1Dot" Width="10" Height="10"
                             Fill="{StaticResource BrushTeal}" Margin="0,0,8,0" />
                    <Ellipse x:Name="Step2Dot" Width="10" Height="10"
                             Fill="{StaticResource BrushLine}" Margin="0,0,8,0" />
                    <Ellipse x:Name="Step3Dot" Width="10" Height="10"
                             Fill="{StaticResource BrushLine}" />
                </StackPanel>

                <!-- Step title -->
                <TextBlock x:Name="StepTitle" Grid.Row="1"
                           Style="{StaticResource TypeTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <!-- Step content -->
                <ContentControl x:Name="StepContent" Grid.Row="2"
                                Margin="0,0,0,16" />

                <!-- Navigation buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button x:Name="BackButton" Content="חזרה"
                            Style="{StaticResource ButtonSecondary}"
                            Click="Back_Click" Visibility="Collapsed"
                            Height="40" Padding="20,0" Margin="0,0,8,0" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="ביטול"
                            Style="{StaticResource ButtonGhost}"
                            Click="Cancel_Click"
                            Height="40" Padding="20,0" Margin="0,0,8,0" />
                    <Button x:Name="NextButton" Content="הבא"
                            Style="{StaticResource ButtonPrimary}"
                            Click="Next_Click"
                            Height="40" Padding="20,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
