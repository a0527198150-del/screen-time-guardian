<UserControl x:Class="ScreenTimeGuardian.ControlPanel.Dialogs.WizardSteps.StepSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel">

    <StackPanel Margin="0,0,0,0">

        <!-- Shortcut buttons row -->
        <WrapPanel Margin="0,0,0,12">
            <Button x:Name="BtnShabbat" Content="שבת" Style="{StaticResource ButtonSecondary}"
                    Margin="0,0,8,0" Click="BtnShortcut_Click" Tag="shabbat"
                    AutomationProperties.Name="קיצור דרך: שבת" />
            <Button x:Name="BtnWorkHours" Content="שעות עבודה" Style="{StaticResource ButtonSecondary}"
                    Margin="0,0,8,0" Click="BtnShortcut_Click" Tag="work"
                    AutomationProperties.Name="קיצור דרך: שעות עבודה" />
            <Button x:Name="BtnNightHours" Content="שעות לילה" Style="{StaticResource ButtonSecondary}"
                    Margin="0,0,8,0" Click="BtnShortcut_Click" Tag="night"
                    AutomationProperties.Name="קיצור דרך: שעות לילה" />
            <Button x:Name="BtnAllTime" Content="כל הזמן" Style="{StaticResource ButtonSecondary}"
                    Click="BtnShortcut_Click" Tag="all"
                    AutomationProperties.Name="קיצור דרך: כל הזמן" />
        </WrapPanel>

        <!-- WeekGrid container -->
        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <local:WeekGrid x:Name="ScheduleGrid" Height="220" />
        </Border>

        <!-- Precise time fields (collapsed by default) -->
        <Button x:Name="TimeToggle" Content="שעות מדויקות ▾" Style="{StaticResource ButtonGhost}"
                Click="TimeToggle_Click" HorizontalAlignment="Left" Height="36"
                FontSize="13" Foreground="{StaticResource BrushInkMuted}"
                AutomationProperties.Name="שעות מדויקות" />
        <StackPanel x:Name="TimePanel" Visibility="Collapsed" Margin="16,8,16,12">
            <WrapPanel>
                <TextBlock Text="משעה:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="{StaticResource FontUi}" FontSize="13"
                           Foreground="{StaticResource BrushInkMuted}" />
                <TextBox x:Name="TxtStartHour" Width="50" Text="22" Margin="0,0,4,0"
                         HorizontalContentAlignment="Center" MaxLength="2" />
                <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontFamily="{StaticResource FontData}" FontSize="15" />
                <TextBox x:Name="TxtStartMin" Width="50" Text="00" Margin="0,0,16,0"
                         HorizontalContentAlignment="Center" MaxLength="2" />

                <TextBlock Text="עד שעה:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="{StaticResource FontUi}" FontSize="13"
                           Foreground="{StaticResource BrushInkMuted}" />
                <TextBox x:Name="TxtEndHour" Width="50" Text="07" Margin="0,0,4,0"
                         HorizontalContentAlignment="Center" MaxLength="2" />
                <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontFamily="{StaticResource FontData}" FontSize="15" />
                <TextBox x:Name="TxtEndMin" Width="50" Text="00"
                         HorizontalContentAlignment="Center" MaxLength="2" />
            </WrapPanel>
        </StackPanel>

        <!-- Summary line -->
        <TextBlock x:Name="SummaryText" FontFamily="{StaticResource FontUi}" FontSize="13"
                   Foreground="{StaticResource BrushInkMuted}" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
