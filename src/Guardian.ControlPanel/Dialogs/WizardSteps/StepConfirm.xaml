<UserControl x:Class="ScreenTimeGuardian.ControlPanel.Dialogs.WizardSteps.StepConfirm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel">

    <StackPanel Margin="0,0,0,0">

        <!-- Confirmation text -->
        <TextBlock x:Name="ConfirmationText"
                   FontFamily="{StaticResource FontDisplay}" FontSize="19"
                   FontWeight="SemiBold" Foreground="{StaticResource BrushInk}"
                   TextWrapping="Wrap" Margin="0,0,0,24" />

        <!-- Save button -->
        <Button x:Name="BtnSave" Content="שמור" Style="{StaticResource ButtonPrimary}"
                Click="BtnSave_Click" HorizontalAlignment="Stretch" Height="44"
                FontSize="15" FontWeight="SemiBold"
                AutomationProperties.Name="שמור כלל" />
    </StackPanel>
</UserControl>
