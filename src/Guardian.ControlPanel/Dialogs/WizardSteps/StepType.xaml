<UserControl x:Class="ScreenTimeGuardian.ControlPanel.Dialogs.WizardSteps.StepType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel">

    <StackPanel>

        <!-- Error message (hidden by default) -->
        <Border x:Name="ErrorBorder" Background="#26A93226" CornerRadius="6"
                Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Text="בחר סוג כלל"
                       Foreground="{StaticResource BrushRose}"
                       FontFamily="{StaticResource FontUi}" FontSize="13" />
        </Border>

        <!-- Three type cards -->
        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,16">

            <!-- App -->
            <Border x:Name="CardApp" Width="160" Height="120" Margin="0,0,12,0"
                    Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="1" CornerRadius="12" Cursor="Hand"
                    MouseLeftButtonDown="CardApp_Click"
                    AutomationProperties.Name="בחירת אפליקציה">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock Text="אפליקציה" FontFamily="{StaticResource FontUi}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushInk}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Google Play / exe" FontFamily="{StaticResource FontUi}" FontSize="12"
                               Foreground="{StaticResource BrushInkMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Site -->
            <Border x:Name="CardSite" Width="160" Height="120" Margin="0,0,12,0"
                    Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="1" CornerRadius="12" Cursor="Hand"
                    MouseLeftButtonDown="CardSite_Click"
                    AutomationProperties.Name="בחירת אתר">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock Text="אתר" FontFamily="{StaticResource FontUi}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushInk}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="כתובת אינטרנט" FontFamily="{StaticResource FontUi}" FontSize="12"
                               Foreground="{StaticResource BrushInkMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Account -->
            <Border x:Name="CardAccount" Width="160" Height="120"
                    Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="1" CornerRadius="12" Cursor="Hand"
                    MouseLeftButtonDown="CardAccount_Click"
                    AutomationProperties.Name="בחירת חשבון">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="👤" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock Text="חשבון" FontFamily="{StaticResource FontUi}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushInk}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Google / Gmail" FontFamily="{StaticResource FontUi}" FontSize="12"
                               Foreground="{StaticResource BrushInkMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Conditional fields based on selection -->
        <StackPanel x:Name="AppField" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="קובץ aplikace:" FontFamily="{StaticResource FontUi}" FontSize="13"
                       Foreground="{StaticResource BrushInkMuted}" Margin="0,0,0,4" />
            <Button x:Name="BtnBrowseApp" Content="בחר קובץ exe…" Style="{StaticResource ButtonSecondary}"
                    Click="BtnBrowseApp_Click" Height="40" HorizontalAlignment="Left"
                    AutomationProperties.Name="בחירת קובץ אפליקציה" />
        </StackPanel>

        <StackPanel x:Name="SiteField" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="כתובת האתר:" FontFamily="{StaticResource FontUi}" FontSize="13"
                       Foreground="{StaticResource BrushInkMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="TxtSiteUrl" Height="40" FontFamily="{StaticResource FontData}"
                     FontSize="13" FlowDirection="LeftToRight"
                     Foreground="{StaticResource BrushInk}" />
            <TextBlock Text="לדוגמה: youtube.com" FontFamily="{StaticResource FontUi}" FontSize="12"
                       Foreground="{StaticResource BrushInkMuted}" Margin="0,4,0,0" />
            <Button x:Name="BtnDiscoveredSites" Content="הוסף מרשימת אתרים שהתגלו"
                    Style="{StaticResource ButtonGhost}" Click="BtnDiscoveredSites_Click"
                    Height="36" HorizontalAlignment="Left" Margin="0,4,0,0"
                    FontFamily="{StaticResource FontUi}" FontSize="13"
                    Foreground="{StaticResource BrushInkMuted}"
                    AutomationProperties.Name="הוסף מרשימת אתרים שהתגלו" />
        </StackPanel>

        <StackPanel x:Name="AccountField" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="כתובת מייל:" FontFamily="{StaticResource FontUi}" FontSize="13"
                       Foreground="{StaticResource BrushInkMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="TxtEmail" Height="40" FontFamily="{StaticResource FontData}"
                     FontSize="13" FlowDirection="LeftToRight"
                     Foreground="{StaticResource BrushInk}" />

            <TextBlock Text="מה לחסום עבור החשבון הזה:"
                       FontFamily="{StaticResource FontUi}" FontSize="13"
                       Foreground="{StaticResource BrushInkMuted}" Margin="0,12,0,8" />
            <WrapPanel x:Name="ServicesPanel">
                <CheckBox x:Name="ChkGmail" Content="Gmail ✉️" Tag="gmail"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkDrive" Content="Drive 🗂️" Tag="drive"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkDocs" Content="Docs / Sheets / Slides 📄" Tag="docs"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkCalendar" Content="Calendar 📅" Tag="calendar"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkChat" Content="Chat 💬" Tag="chat"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkMeet" Content="Meet 🎥" Tag="meet"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkPhotos" Content="Photos 🖼️" Tag="photos"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkSearch" Content="חיפוש 🔍" Tag="search"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkYoutube" Content="YouTube ▶️" Tag="youtube"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkGemini" Content="Gemini ✨" Tag="gemini"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkMaps" Content="Maps 🗺️" Tag="maps"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkTranslate" Content="Translate 🌐" Tag="translate"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkKeep" Content="Keep 📝" Tag="keep"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkNews" Content="News 📰" Tag="news"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkFinance" Content="Finance 📈" Tag="finance"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkGroups" Content="Groups 👥" Tag="groups"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
                <CheckBox x:Name="ChkOne" Content="Google One 💾" Tag="one"
                          Margin="0,0,16,8" FontFamily="{StaticResource FontUi}" FontSize="13"
                          Foreground="{StaticResource BrushInk}" />
            </WrapPanel>
            <TextBlock Text="התוסף חוסם את השירותים המסומנים רק כשמחוברים לחשבון הזה."
                       FontFamily="{StaticResource FontUi}" FontSize="12"
                       Foreground="{StaticResource BrushInkMuted}" Margin="0,4,0,0" />

            <!-- Third-party sites that are reached with this Google account (Sign in with Google) -->
            <TextBlock Text="אתרים שנכנסים אליהם בכניסה עם Google:"
                       FontFamily="{StaticResource FontUi}" FontSize="13"
                       Foreground="{StaticResource BrushInkMuted}" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="TxtAccountSite" Width="260" Height="36"
                         FontFamily="{StaticResource FontData}" FontSize="13"
                         FlowDirection="LeftToRight"
                         Foreground="{StaticResource BrushInk}"
                         KeyDown="TxtAccountSite_KeyDown" />
                <Button Content="הוסף" Style="{StaticResource ButtonSecondary}"
                        Height="36" Padding="16,0" Margin="8,0,0,0"
                        Click="BtnAddAccountSite_Click"
                        AutomationProperties.Name="הוסף אתר לחשבון" />
            </StackPanel>
            <ListBox x:Name="AccountSitesList" Height="110"
                     BorderThickness="1" SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource FontData}"
                                   FontSize="13" FlowDirection="LeftToRight"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="הסר נבחר" Style="{StaticResource ButtonDanger}"
                    Height="34" Padding="14,0" HorizontalAlignment="Left"
                    Margin="0,6,0,0" Click="BtnRemoveAccountSite_Click"
                    AutomationProperties.Name="הסר אתר נבחר מהחשבון" />
            <TextBlock Text="האתרים נחסמים על ידי התוסף רק כשמחוברים לחשבון הזה — למשל אתר שנכנסים אליו בכניסה עם Google."
                       FontFamily="{StaticResource FontUi}" FontSize="12"
                       Foreground="{StaticResource BrushInkMuted}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
