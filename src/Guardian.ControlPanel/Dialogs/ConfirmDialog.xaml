<Window x:Class="ScreenTimeGuardian.ControlPanel.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="Auto"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False"
        Opacity="0.95"
        RenderTransformOrigin="0.5,0.5">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.95" To="1" Duration="0:0:0.11" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.11" Value="1" KeySpline="{StaticResource EaseOutStrong}" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.11" Value="1" KeySpline="{StaticResource EaseOutStrong}" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.RenderTransform>
        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
    </Window.RenderTransform>

    <Grid>
        <Border Background="#66000000" MouseLeftButtonDown="Overlay_Click" />
        <Border Background="{StaticResource BrushSurface}" CornerRadius="12"
                Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                MinWidth="340">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270"
                                  Opacity="0.14" Color="#141B2E" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="DialogTitle" Style="{StaticResource TypeTitle}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="DialogMessage" Style="{StaticResource TypeBody}"
                           Foreground="{StaticResource BrushInkMuted}"
                           TextWrapping="Wrap" Margin="0,0,0,20" />
                <PasswordBox x:Name="DialogPassword" Visibility="Collapsed"
                             FlowDirection="LeftToRight" Margin="0,0,0,12" />
                <TextBlock x:Name="PasswordError" Foreground="{StaticResource BrushRose}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="CancelButton" Content="ביטול"
                            Style="{StaticResource ButtonSecondary}"
                            Click="Cancel_Click" Height="40" Padding="20,0"
                            Margin="0,0,8,0" />
                    <Button x:Name="ConfirmButton" Content="אישור"
                            Style="{StaticResource ButtonPrimary}"
                            Click="Confirm_Click" Height="40" Padding="20,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
