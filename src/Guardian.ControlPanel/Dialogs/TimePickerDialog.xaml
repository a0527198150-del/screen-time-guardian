<Window x:Class="ScreenTimeGuardian.ControlPanel.Dialogs.TimePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushCanvas}"
        WindowStyle="None"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
            CornerRadius="16" Padding="24" Margin="10"
            Effect="{StaticResource ShadowFloat}">

        <StackPanel>

            <TextBlock Text="בחירת שעה" Style="{StaticResource TypeTitle}"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />

            <!-- Live digital readout — click to switch between hour/minute mode -->
            <Button x:Name="ReadoutButton" Click="Readout_Click"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Padding="0" Height="Auto" Margin="0,4,0,0">
                <TextBlock x:Name="ReadoutText" Text="22:30"
                           FontFamily="{StaticResource FontData}" FontSize="44"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushInk}"
                           HorizontalAlignment="Center" />
            </Button>

            <TextBlock x:Name="ModeText" Text="בחר שעה"
                       Style="{StaticResource TypeMeta}"
                       HorizontalAlignment="Center" Margin="0,0,0,12" />

            <!-- Clock face -->
            <Border Width="252" Height="252" CornerRadius="126"
                    BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                    Background="{StaticResource BrushCanvas}"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <Canvas x:Name="ClockCanvas" Width="252" Height="252"
                        FlowDirection="LeftToRight" Background="Transparent"
                        MouseLeftButtonDown="ClockCanvas_MouseLeftButtonDown" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="ביטול" Style="{StaticResource ButtonSecondary}"
                        Click="Cancel_Click" Height="40" Padding="20,0"
                        Margin="0,0,8,0" />
                <Button Content="אישור" Style="{StaticResource ButtonPrimary}"
                        Click="Ok_Click" Height="40" Padding="20,0" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
