<UserControl x:Class="ScreenTimeGuardian.ControlPanel.Shell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel"
             FlowDirection="RightToLeft"
             Background="{StaticResource BrushCanvas}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top navigation header -->
            <RowDefinition Height="Auto" />
            <!-- Transient message strip -->
            <RowDefinition Height="Auto" />
            <!-- Active page -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             HEADER — brand on the right, page tabs in the center,
             service status on the left.
             ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand (right in RTL) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="שומר זמן מסך" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTeal}"
                               FontFamily="{StaticResource FontUi}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Page tabs (center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Border x:Name="NavHome" Cursor="Hand" CornerRadius="20"
                            Padding="16,8" Margin="0,0,4,0"
                            AutomationProperties.Name="בית">
                        <Border.Background>
                            <SolidColorBrush x:Name="NavHomeBg" Color="Transparent" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3E0;" FontSize="15" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NavHomeText" Text="בית" FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource FontUi}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavRules" Cursor="Hand" CornerRadius="20"
                            Padding="16,8" Margin="0,0,4,0"
                            AutomationProperties.Name="כללים">
                        <Border.Background>
                            <SolidColorBrush x:Name="NavRulesBg" Color="Transparent" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2696;" FontSize="15" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NavRulesText" Text="כללים" FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource FontUi}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavSettings" Cursor="Hand" CornerRadius="20"
                            Padding="16,8"
                            AutomationProperties.Name="הגדרות">
                        <Border.Background>
                            <SolidColorBrush x:Name="NavSettingsBg" Color="Transparent" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2699;" FontSize="15" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NavSettingsText" Text="הגדרות" FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource FontUi}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Service status (left in RTL) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="{StaticResource BrushTeal}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusLabel" Text="אכיפה פעילה"
                               Foreground="{StaticResource BrushInkMuted}" FontSize="13"
                               FontFamily="{StaticResource FontUi}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             MESSAGE STRIP — transient feedback (save results, errors).
             ============================================================ -->
        <Border x:Name="MessageBar" Grid.Row="1" Visibility="Collapsed"
                Padding="20,8" Background="{StaticResource BrushTealSoft}">
            <TextBlock x:Name="MessageText" FontSize="13"
                       FontFamily="{StaticResource FontUi}"
                       Foreground="{StaticResource BrushInk}" TextWrapping="Wrap" />
        </Border>

        <!-- ============================================================
             PAGES — each destination is its own full page.
             ============================================================ -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel MaxWidth="980" HorizontalAlignment="Center"
                            Margin="32,24,32,32">
                    <local:HomeView x:Name="HomeViewControl" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RulesScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel MaxWidth="980" HorizontalAlignment="Center"
                            Margin="32,24,32,32">
                    <local:RulesView x:Name="RulesViewControl" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel MaxWidth="980" HorizontalAlignment="Center"
                            Margin="32,24,32,32">
                    <local:SettingsView x:Name="SettingsViewControl" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Snackbar — floats above everything -->
        <local:Snackbar x:Name="Snackbar" Grid.RowSpan="3" />
    </Grid>
</UserControl>
