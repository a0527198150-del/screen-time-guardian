<UserControl x:Class="ScreenTimeGuardian.ControlPanel.Shell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel"
             FlowDirection="RightToLeft"
             Background="{StaticResource BrushCanvas}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Content area -->
            <ColumnDefinition Width="*" />
            <!-- Sidebar -->
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             CONTENT AREA — max width 900, centered, 32px padding.
             ============================================================ -->
        <Border Grid.Column="1" Background="{StaticResource BrushCanvas}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Center"
                                Margin="32" VerticalAlignment="Top">

                        <!-- HomeView -->
                        <local:HomeView x:Name="HomeViewControl"
                                        Visibility="Visible" />

                        <!-- RulesView -->
                        <local:RulesView x:Name="RulesViewControl"
                                          Visibility="Collapsed" />

                        <!-- SettingsView -->
                        <local:SettingsView x:Name="SettingsViewControl"
                                             Visibility="Collapsed" />

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================================================
             SIDEBAR — 240px, Ink background, RTL.
             Three nav items, status dot at bottom.
             ============================================================ -->
        <Border Grid.Column="0" Background="{StaticResource BrushInk}">
            <DockPanel Margin="0,32,0,32">

                <!-- Status dot — always at bottom, always visible -->
                <Border DockPanel.Dock="Bottom" Margin="0,0,0,0"
                        HorizontalAlignment="Right" Padding="20,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                 Fill="{StaticResource BrushTeal}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="StatusLabel" Text="אכיפה פעילה"
                                   Foreground="#94A3B8" FontSize="13"
                                   FontFamily="{StaticResource FontUi}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Brand -->
                <TextBlock DockPanel.Dock="Top" Text="שומר זמן מסך"
                           Foreground="White" FontSize="19"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource FontUi}"
                           Margin="20,0,20,32"
                           HorizontalAlignment="Right" />

                <!-- Navigation items -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Border x:Name="NavHome" Cursor="Hand" Padding="0"
                            CornerRadius="0" Margin="0,0,0,2"
                            AutomationProperties.Name="בית">
                        <Border.Background>
                            <SolidColorBrush x:Name="NavHomeBg" Color="Transparent" />
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Margin="20,12" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F3E0;" FontSize="18" Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="בית" Foreground="#94A3B8" FontSize="15"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource FontUi}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="3"
                                    HorizontalAlignment="Right" CornerRadius="2">
                                <Border.Background>
                                    <SolidColorBrush x:Name="NavHomeIndicator" Color="Transparent" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="NavRules" Cursor="Hand" Padding="0"
                            CornerRadius="0" Margin="0,0,0,2"
                            AutomationProperties.Name="כללים">
                        <Border.Background>
                            <SolidColorBrush x:Name="NavRulesBg" Color="Transparent" />
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Margin="20,12" VerticalAlignment="Center">
                                <TextBlock Text="&#x2696;" FontSize="18" Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="כללים" Foreground="#94A3B8" FontSize="15"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource FontUi}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="3"
                                    HorizontalAlignment="Right" CornerRadius="2">
                                <Border.Background>
                                    <SolidColorBrush x:Name="NavRulesIndicator" Color="Transparent" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="NavSettings" Cursor="Hand" Padding="0"
                            CornerRadius="0" Margin="0,0,0,2"
                            AutomationProperties.Name="הגדרות">
                        <Border.Background>
                            <SolidColorBrush x:Name="NavSettingsBg" Color="Transparent" />
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Margin="20,12" VerticalAlignment="Center">
                                <TextBlock Text="&#x2699;" FontSize="18" Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="הגדרות" Foreground="#94A3B8" FontSize="15"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource FontUi}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="3"
                                    HorizontalAlignment="Right" CornerRadius="2">
                                <Border.Background>
                                    <SolidColorBrush x:Name="NavSettingsIndicator" Color="Transparent" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Snackbar — floats above everything -->
        <local:Snackbar x:Name="Snackbar" Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
