<Window x:Class="ScreenTimeGuardian.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel"
        Title="שומר זמן מסך" Height="640" Width="1060"
        MinHeight="480" MinWidth="800"
        FlowDirection="RightToLeft"
        KeyboardNavigation.TabNavigation="Continue"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Auth bar (shown before authentication) -->
            <RowDefinition Height="Auto" />
            <!-- Shell content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Authentication bar -->
        <Border x:Name="AuthBar" Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1"
                Padding="20,12" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="שומר זמן מסך"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTeal}"
                           VerticalAlignment="Center" Margin="0,0,20,0"
                           FontFamily="{StaticResource FontUi}" />

                <PasswordBox Grid.Column="1" x:Name="AppPasswordBox"
                             FlowDirection="LeftToRight"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource FontUi}" />

                <Button Grid.Column="2" x:Name="AuthButton" Content="אמת / הגדר"
                        Style="{StaticResource ButtonPrimary}"
                        Click="AuthButton_Click" Margin="0,0,8,0" />

                <TextBlock Grid.Column="4" x:Name="HeaderStatus"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource BrushInkMuted}"
                           FontSize="13" FontFamily="{StaticResource FontUi}"
                           MaxWidth="400" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Shell navigation + content -->
        <local:Shell x:Name="ShellControl" Grid.Row="1"
                     Visibility="Collapsed" />
    </Grid>
</Window>
