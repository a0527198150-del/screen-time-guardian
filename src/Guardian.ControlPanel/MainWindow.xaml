<Window x:Class="ScreenTimeGuardian.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTimeGuardian.ControlPanel"
        Title="שומר זמן מסך" Height="640" Width="1060"
        MinHeight="480" MinWidth="800"
        FlowDirection="RightToLeft"
        KeyboardNavigation.TabNavigation="Continue"
        Background="{StaticResource BrushCanvas}"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico">

    <Grid>

        <!-- ============================================================
             AUTH VIEW — centered login card. Shown until the app
             password is verified (or set on first run).
             ============================================================ -->
        <Grid x:Name="AuthView" Visibility="Visible">
            <Border Background="{StaticResource BrushCanvas}">
                <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                        CornerRadius="16" Padding="40,36"
                        Effect="{StaticResource ShadowFloat}">
                    <StackPanel>

                        <!-- Brand mark -->
                        <Border Width="72" Height="72" CornerRadius="36"
                                Background="{StaticResource BrushTealSoft}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🛡️" FontSize="34"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="שומר זמן מסך" Style="{StaticResource TypeDisplay}"
                                   FontSize="28" HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="בקרת זמן מסך וחסימות"
                                   Style="{StaticResource TypeMeta}"
                                   FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,0,0,28" />

                        <!-- Password -->
                        <TextBlock Text="סיסמה" Style="{StaticResource TypeLabel}"
                                   Margin="0,0,0,6" />
                        <Grid Height="42">
                            <PasswordBox x:Name="AppPasswordBox"
                                         FlowDirection="LeftToRight"
                                         FontFamily="{StaticResource FontUi}"
                                         FontSize="15"
                                         VerticalContentAlignment="Center"
                                         Padding="14,0"
                                         PasswordChanged="AppPasswordBox_PasswordChanged"
                                         KeyDown="AppPasswordBox_KeyDown" />
                            <TextBlock x:Name="PasswordPlaceholder"
                                       Text="הזן סיסמה"
                                       FontFamily="{StaticResource FontUi}"
                                       FontSize="15"
                                       Foreground="{StaticResource BrushInkMuted}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <!-- Status / error -->
                        <TextBlock x:Name="AuthStatus"
                                   FontFamily="{StaticResource FontUi}"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushInkMuted}"
                                   TextWrapping="Wrap" MinHeight="34"
                                   Margin="0,10,0,0" />

                        <!-- Primary action -->
                        <Button x:Name="AuthButton" Content="כניסה"
                                Style="{StaticResource ButtonPrimary}"
                                Click="AuthButton_Click" Height="44"
                                FontSize="15" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch" />

                        <TextBlock Text="בהפעלה הראשונה הסיסמה שתוזן תיקבע כסיסמת הניהול."
                                   Style="{StaticResource TypeMeta}"
                                   FontSize="12" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,16,0,0" />

                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ============================================================
             SHELL — full app after authentication.
             ============================================================ -->
        <local:Shell x:Name="ShellControl" Visibility="Collapsed" />
    </Grid>
</Window>
