<Window x:Class="ScreenTimeGuardian.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שומר זמן מסך" Height="880" Width="1180"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="#F8F9FA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="GoogleBlue" Color="#1A73E8" />
        <SolidColorBrush x:Key="GoogleBlueDark" Color="#1557B0" />
        <SolidColorBrush x:Key="Ink" Color="#202124" />
        <SolidColorBrush x:Key="MutedInk" Color="#5F6368" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#F1F3F4" />
        <SolidColorBrush x:Key="BorderLine" Color="#DADCE0" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,3,6,3" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource GoogleBlue}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoogleBlue}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">

        <!-- Login bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderLine}"
                BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="שומר זמן מסך" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource GoogleBlue}" VerticalAlignment="Center" Margin="0,0,22,0" />
                <PasswordBox Grid.Column="1" x:Name="AppPasswordBox" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="אמת / הגדר" Style="{StaticResource PrimaryButton}" Click="AuthenticateButton_OnClick" />
                <Button Grid.Column="3" Content="טען מחדש" Click="ReloadButton_OnClick" />
                <Button Grid.Column="4" x:Name="SaveButton" Content="שמור הכל" Style="{StaticResource PrimaryButton}" Click="SaveButton_OnClick" />
                <TextBlock Grid.Column="5" x:Name="HeaderStatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" MaxWidth="420" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,9" Margin="0,14,0,0" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#137333" />
        </Border>

        <TabControl x:Name="MainTabs">

            <!-- ============ APPLICATIONS ============ -->
            <TabItem Header="אפליקציות">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Rule list -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="כללי חסימה" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="כלל חדש" Click="AddRuleButton_OnClick" />
                            <Button Content="שכפל" Click="DuplicateRuleButton_OnClick" />
                            <Button Content="מחק" Click="DeleteRuleButton_OnClick" />
                        </StackPanel>
                        <ListBox x:Name="RulesListBox" SelectionChanged="RulesListBox_OnSelectionChanged" />
                    </DockPanel>

                    <!-- Rule editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RuleEditorPanel" IsEnabled="False">

                            <GroupBox Header="פרטי הכלל">
                                <StackPanel>
                                    <TextBlock Text="שם הכלל:" />
                                    <TextBox x:Name="RuleNameBox" LostFocus="RuleNameBox_OnLostFocus" />
                                    <CheckBox x:Name="RuleEnabledBox" Content="הכלל פעיל" Margin="0,8,0,4"
                                              Checked="RuleEnabled_OnChanged" Unchecked="RuleEnabled_OnChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="האכיפה היא ניתוק מהאינטרנט: חוק חומת אש יוצא על קובץ ההפעלה. האפליקציה נפתחת כרגיל אבל אין לה גישה לרשת. התוכנה הזו לא סוגרת תהליכים בכוח, בשום מצב — לכן היא לא יכולה להפיל את המחשב. הסרת החוק דורשת הרשאת מנהל." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="האפליקציות בכלל הזה">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="נבחרו:" />
                                        <ListBox x:Name="TargetsListBox" Height="150" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="בחר קובץ exe…" Click="BrowseTargetButton_OnClick" />
                                            <Button Content="הסר נבחר" Click="RemoveTargetButton_OnClick" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="אפליקציות פתוחות כרגע:" />
                                        <ListBox x:Name="RunningAppsListBox" Height="150" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="רענן" Click="RefreshRunningButton_OnClick" />
                                            <Button Content="הוסף לכלל" Click="AddRunningButton_OnClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="על מי הכלל חל">
                                <StackPanel>
                                    <CheckBox x:Name="AllUsersBox" Content="כל המשתמשים במחשב"
                                              Checked="AllUsers_OnChanged" Unchecked="AllUsers_OnChanged" />
                                    <TextBlock Text="או בחר משתמשים ספציפיים (ניתן לבחור כמה):" Margin="0,8,0,2" />
                                    <ListBox x:Name="UsersListBox" Height="110" SelectionMode="Multiple"
                                             SelectionChanged="UsersListBox_OnSelectionChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="בחירת משתמש מגבילה את החוק לחשבון Windows הזה בלבד. שאר המשתמשים במחשב לא מושפעים." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="לוח זמנים">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="חלונות זמן בכלל הזה:" />
                                        <ListBox x:Name="WindowsListBox" Height="150"
                                                 SelectionChanged="WindowsListBox_OnSelectionChanged" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="חלון חדש" Click="AddWindowButton_OnClick" />
                                            <Button Content="מחק חלון" Click="RemoveWindowButton_OnClick" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" x:Name="WindowEditorPanel" IsEnabled="False">
                                        <TextBlock Text="ימים:" FontWeight="Bold" />
                                        <WrapPanel>
                                            <CheckBox x:Name="DaySun" Content="ראשון" Margin="0,4,10,4" Click="WindowField_OnChanged" />
                                            <CheckBox x:Name="DayMon" Content="שני" Margin="0,4,10,4" Click="WindowField_OnChanged" />
                                            <CheckBox x:Name="DayTue" Content="שלישי" Margin="0,4,10,4" Click="WindowField_OnChanged" />
                                            <CheckBox x:Name="DayWed" Content="רביעי" Margin="0,4,10,4" Click="WindowField_OnChanged" />
                                            <CheckBox x:Name="DayThu" Content="חמישי" Margin="0,4,10,4" Click="WindowField_OnChanged" />
                                            <CheckBox x:Name="DayFri" Content="שישי" Margin="0,4,10,4" Click="WindowField_OnChanged" />
                                            <CheckBox x:Name="DaySat" Content="שבת" Margin="0,4,10,4" Click="WindowField_OnChanged" />
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="ימי חול" Click="PresetWeekdaysButton_OnClick" />
                                            <Button Content="כל השבוע" Click="PresetAllDaysButton_OnClick" />
                                            <Button Content="נקה" Click="PresetClearDaysButton_OnClick" />
                                        </StackPanel>
                                        <CheckBox x:Name="AllDayBox" Content="כל היום" Margin="0,10,0,4" Click="WindowField_OnChanged" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="משעה:" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="WindowStartBox" FlowDirection="LeftToRight"
                                                     LostFocus="WindowField_OnChanged" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="עד שעה:" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="WindowEndBox" FlowDirection="LeftToRight"
                                                     LostFocus="WindowField_OnChanged" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="WindowEnabledBox" Content="החלון פעיל"
                                                      VerticalAlignment="Center" Click="WindowField_OnChanged" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="השהיית אכיפה (שניות):" FontSize="12" />
                                                <TextBox x:Name="ActivationDelayBox" FlowDirection="LeftToRight"
                                                         LostFocus="WindowField_OnChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="ההשהיה מתחילה כשהחלון נכנס לתוקף. ברירת המחדל 0 = חסימה מיידית. הטווח המאושר הוא 0 עד 86400 שניות. פורמט שעה HH:mm; אם הסיום קטן מההתחלה החלון חוצה חצות." />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ GOOGLE ACCOUNTS ============ -->
            <TabItem Header="חשבונות Google">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="חשבונות" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="חשבון חדש" Click="AddAccountButton_OnClick" />
                            <Button Content="מחק" Click="DeleteAccountButton_OnClick" />
                        </StackPanel>
                        <ListBox x:Name="AccountsListBox" SelectionChanged="AccountsListBox_OnSelectionChanged" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AccountEditorPanel" IsEnabled="False">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="חסימה לפי חשבון פועלת דרך תוסף הדפדפן. זו הדרך היחידה לחסום את הג'ימייל שלך בלי לחסום את של האחים — ברמת המחשב אי אפשר להבחין בין חשבון לחשבון." />

                            <GroupBox Header="פרטי החשבון">
                                <StackPanel>
                                    <TextBlock Text="כתובת המייל:" />
                                    <TextBox x:Name="AccountEmailBox" FlowDirection="LeftToRight" LostFocus="AccountField_OnLostFocus" />
                                    <CheckBox x:Name="AccountEnabledBox" Content="הכלל פעיל" Margin="0,8,0,0"
                                              Click="AccountField_OnLostFocus" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="שירותי Google לחסימה">
                                <WrapPanel x:Name="ServicesPanel">
                                    <CheckBox x:Name="SvcGmail" Content="Gmail" Tag="gmail" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcDrive" Content="Drive" Tag="drive" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcDocs" Content="Docs" Tag="docs" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcCalendar" Content="Calendar" Tag="calendar" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcChat" Content="Chat" Tag="chat" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcMeet" Content="Meet" Tag="meet" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcYouTube" Content="YouTube" Tag="youtube" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcPhotos" Content="Photos" Tag="photos" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                    <CheckBox x:Name="SvcSearch" Content="חיפוש Google" Tag="search" Margin="0,4,14,4" Click="ServiceCheck_OnChanged" />
                                </WrapPanel>
                            </GroupBox>

                            <GroupBox Header="אתרים חיצוניים שנחסמים כשמחוברים בחשבון הזה">
                                <StackPanel>
                                    <ListBox x:Name="AccountSitesListBox" Height="130" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="NewSiteBox" Width="260" FlowDirection="LeftToRight" />
                                        <Button Content="הוסף אתר" Click="AddAccountSiteButton_OnClick" />
                                        <Button Content="הסר נבחר" Click="RemoveAccountSiteButton_OnClick" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="פורמט: https://example.com — התוסף יחסום את האתר רק כשאתה מחובר בחשבון הזה." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="לוח זמנים לחשבון">
                                <StackPanel>
                                    <ListBox x:Name="AccountWindowsListBox" Height="120"
                                             SelectionChanged="AccountWindowsListBox_OnSelectionChanged" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="העתק לוח זמנים מכלל אפליקציות נבחר" Click="CopyScheduleButton_OnClick" />
                                        <Button Content="חלון 'כל היום, כל השבוע'" Click="AddAlwaysWindowButton_OnClick" />
                                        <Button Content="מחק חלון" Click="RemoveAccountWindowButton_OnClick" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="השהיית אכיפה לחלון הנבחר (שניות):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="AccountWindowDelayBox" Width="100" FlowDirection="LeftToRight"
                                                 LostFocus="AccountWindowDelayBox_OnLostFocus" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="0 = חסימה מיידית. ההשהיה נשמרת בחלון הזמן עצמו, גם כשההגדרה מופעלת בלי לוח הבקרה." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ DISCOVERED SITES ============ -->
            <TabItem Header="אתרים שהתגלו">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="כל אתר שנכנסת אליו באמצעות 'התחבר עם Google' נרשם כאן אוטומטית, יחד עם החשבון שבו השתמשת. בחר אתר והוסף אותו לחשבון כדי לחסום אותו לפי לוח זמנים." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <Button Content="הוסף לחשבון הנבחר בלשונית חשבונות" Click="PromoteDiscoveredButton_OnClick" />
                        <Button Content="הסתר מהרשימה" Click="DismissDiscoveredButton_OnClick" />
                    </StackPanel>
                    <ListBox x:Name="DiscoveredListBox" />
                </DockPanel>
            </TabItem>

            <!-- ============ WEBSITES ============ -->
            <TabItem Header="אתרים לכל המחשב">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="חסימה זו חלה על כל משתמשי המחשב וכל הדפדפנים. אין כאן הפרדה בין חשבונות. אם מותקן נטפרי, בדוק שהחסימה לא מתנגשת איתו לפני שאתה מפעיל אכיפה." />
                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NewDomainBox" Width="260" FlowDirection="LeftToRight" />
                            <Button Content="הוסף דומיין" Click="AddDomainButton_OnClick" />
                            <Button Content="הסר נבחר" Click="RemoveDomainButton_OnClick" />
                            <Button Content="חלון 'כל היום, כל השבוע'" Click="AddDomainAlwaysWindowButton_OnClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="השהיית אכיפה לאתר שנבחר (שניות):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="WebsiteDelayBox" Width="100" FlowDirection="LeftToRight"
                                     LostFocus="WebsiteDelayBox_OnLostFocus" />
                        </StackPanel>
                        <CheckBox x:Name="EnforceWebsitesBox" Content="הפעל אכיפה בפועל (ללא סימון — מצב האזנה בלבד)" Margin="0,10,0,0" />
                    </StackPanel>
                    <ListBox x:Name="DomainsListBox" SelectionChanged="DomainsListBox_OnSelectionChanged" />
                </DockPanel>
            </TabItem>


            <!-- ============ BROWSER LOCKDOWN ============ -->
            <TabItem Header="נעילת דפדפנים">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="הבעיה: אפשר להתקין דפדפן חדש בחצי דקה, ואז התוסף לא נמצא שם וכל החסימות ברמת החשבון נעלמות. שלוש השכבות כאן סוגרות את הפער." />

                        <GroupBox Header="שכבה 1 — כפיית התוסף (מבוצע בסקריפט, לא כאן)">
                            <TextBlock TextWrapping="Wrap"
                                       Text="הרץ פעם אחת עם הרשאת מנהל: Set-BrowserPolicies.ps1 -ExtensionId &lt;מזהה&gt;. הפעולה כופה את התוסף על Chrome ועל Edge, חוסמת התקנת תוספים אחרים, ומבטלת גלישה פרטית ומצב אורח. חל על כל המשתמשים." />
                        </GroupBox>

                        <GroupBox Header="שכבה 2 — חסימת הפעלה של דפדפנים לא מאושרים">
                            <StackPanel>
                                <CheckBox x:Name="BlockBrowserLaunchBox"
                                          Content="חסום הפעלה של דפדפנים שאינם מאושרים" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="נרשם ב־Image File Execution Options לפי שם קובץ. Firefox, Brave, Opera, Vivaldi, Tor ועוד פשוט לא ייפתחו, ותופיע הודעה בעברית. עובד ב־Windows 10 Home, חל על כל המשתמשים, והסרה דורשת הרשאת מנהל." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="שכבה 3 — סורק דפדפנים מוסתרים">
                            <StackPanel>
                                <CheckBox x:Name="ScanHiddenBrowsersBox"
                                          Content="סרוק את הדיסק ונתק דפדפנים לא מאושרים מהאינטרנט" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="תדירות סריקה (דקות):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="ScanIntervalBox" Width="80" FlowDirection="LeftToRight" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="שכבה 2 עובדת לפי שם קובץ, ולכן שינוי שם עוקף אותה. הסורק מזהה לפי המטא־דאטה של הקובץ (יצרן ושם מוצר) ולא לפי השם, ומוסיף חוק חומת אש. הדפדפן ייפתח — בלי אינטרנט." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="דפדפנים מאושרים">
                            <StackPanel>
                                <ListBox x:Name="ApprovedBrowsersListBox" Height="120" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="זהה אוטומטית Chrome ו־Edge" Click="DetectBrowsersButton_OnClick" />
                                    <Button Content="הוסף ידנית…" Click="AddApprovedBrowserButton_OnClick" />
                                    <Button Content="הסר נבחר" Click="RemoveApprovedBrowserButton_OnClick" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="שים לב: הוספת דפדפן לרשימה הזו היא הקלה, ולכן היא כפופה לזמן הצינון." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="מה זה עדיין לא תופס">
                            <TextBlock TextWrapping="Wrap" Foreground="#92400E"
                                       Text="דפדפן נייד ששמו שונה וגם המטא־דאטה שלו נוקתה, שרץ מדיסק חיצוני, בחלון שבין שתי סריקות. זה דורש מאמץ אמיתי ולא חצי דקה — אבל זה אפשרי. כאן תוכנת הסינון אמורה לחסום את ההורדה מלכתחילה." />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ CHANGE CONTROL ============ -->
            <TabItem Header="בקרת שינויים">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="זמן צינון">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="הוספת חסימה נכנסת לתוקף מיד, תמיד. הורדת חסימה ממתינה את הזמן שנקבע כאן. הסיסמה נשארת אצלך — מה שממתין זו רק ההחלטה של הרגע." />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="שעות המתנה להקלה:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="CoolingOffBox" Width="80" FlowDirection="LeftToRight" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="0 = כל שינוי מיידי, בלי המתנה. אפשר להעלות את הערך בכל רגע והוא ייכנס לתוקף מיד. הורדת הערך היא בעצמה הקלה, ולכן היא ממתינה את הזמן הישן." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="שינוי ממתין">
                            <StackPanel>
                                <TextBlock x:Name="PendingChangeText" TextWrapping="Wrap" FontSize="14"
                                           Text="אין שינוי ממתין." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="רענן" Click="RefreshStatusButton_OnClick" />
                                    <Button Content="בטל את השינוי הממתין" Click="CancelPendingButton_OnClick" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="ביטול שינוי ממתין משאיר את ההגדרה המחמירה, ולכן הוא תמיד מיידי." />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ SAFETY ============ -->
            <TabItem Header="בטיחות ומצב">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="מצב השירות">
                            <StackPanel>
                                <TextBlock x:Name="ServiceStatusText" TextWrapping="Wrap" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="רענן מצב" Click="RefreshStatusButton_OnClick" />
                                    <Button Content="בטל מצב בטוח והפעל אכיפה מחדש" Click="ClearSafeModeButton_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="מנגנוני בטיחות">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="השירות מזהה קריסה של ההפעלה הקודמת ונכנס אוטומטית למצב בטוח. הוא גם לא אוכף כלום בדקות הראשונות אחרי הפעלת המחשב, כך שתמיד אפשר להיכנס ולתקן." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="תקופת חסד אחרי הפעלת המחשב (שניות):" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="BootGraceBox" FlowDirection="LeftToRight" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="תקופת חסד אחרי הפעלת השירות (שניות):" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ServiceGraceBox" FlowDirection="LeftToRight" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="מקסימום פעולות אכיפה בדקה:" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxActionsBox" FlowDirection="LeftToRight" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Text="התוכנה הזו לא סוגרת תהליכים בכוח. אין בה קוד שנוגע בתהליך רץ. כל האכיפה היא חוקי חומת אש ומפתחות רגיסטרי — פעולות שלא יכולות לערער את יציבות Windows." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="מתג חירום">
                            <TextBlock TextWrapping="Wrap"
                                       Text="אם משהו משתבש: מנהל יכול ליצור קובץ ריק בשם SAFEMODE בתיקייה C:\ProgramData\ScreenTimeGuardian — כל האכיפה נעצרת מיד, בלי להסיר את התוכנה ובלי אתחול." />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
