<Window x:Class="ScreenTimeGuardian.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שומר זמן מסך" Height="900" Width="1100"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="שומר זמן מסך" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="ניהול לוח זמנים, אתרים, אפליקציות ודפדפנים מאושרים" FontSize="15" Foreground="Gray" />

            <GroupBox Header="סיסמת האפליקציה" Margin="0,22,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="הסיסמה הזו נפרדת מסיסמת Windows ומשמשת לניהול ההגדרות היומיומי." />
                    <StackPanel Orientation="Horizontal">
                        <PasswordBox x:Name="AppPasswordBox" Width="280" FlowDirection="LeftToRight" />
                        <Button Content="אמת או הגדר סיסמה" Padding="14,6" Margin="10,0,0,0" Click="AuthenticateButton_OnClick" />
                    </StackPanel>
                    <TextBlock Text="בהפעלה הראשונה הסיסמה תוגדר. לאחר מכן היא תידרש לכל שינוי." Foreground="DarkOrange" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="חשבון Google מוגן" Margin="0,22,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="כתובת החשבון שייחסמו השירותים שלו בזמן החסימה:" />
                    <TextBox x:Name="AccountEmailBox" FlowDirection="LeftToRight" />
                    <TextBlock Text="שירותים מופרדים בפסיקים (לדוגמה: gmail, chat, drive):" />
                    <TextBox x:Name="GoogleServicesBox" FlowDirection="LeftToRight" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="אתרים חסומים לכל המחשב" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="דומיין אחד בכל שורה. החסימה תחול על כל משתמשי המחשב וכל הדפדפנים." />
                    <TextBox x:Name="BlockedDomainsBox" Height="110" AcceptsReturn="True" TextWrapping="NoWrap" FlowDirection="LeftToRight" />
                    <CheckBox x:Name="EnforceWebsitesBox" Content="הפעל אכיפה בפועל (יש לבדוק תאימות לנטפרי לפני הפעלה)" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="אפליקציות חסומות" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="שם קובץ הפעלה אחד בכל שורה, לדוגמה game.exe. בזמן חסימה השירות יסגור את התהליך ואת תהליכי־הבן שלו." />
                    <TextBox x:Name="BlockedApplicationsBox" Height="90" AcceptsReturn="True" TextWrapping="NoWrap" FlowDirection="LeftToRight" />
                    <CheckBox x:Name="StrictPortableModeBox" Content="מצב מחמיר: חסום גם תוכנות שמופעלות מתיקיות משתמש בזמן חסימה" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="דפדפנים מותקנים ואישורי מנהל" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="דפדפנים שזוהו ברשומות Windows:" />
                        <Button Content="רענן רשימת דפדפנים" Padding="10,6" Margin="0,4" Click="DiscoverBrowsersButton_OnClick" />
                        <ListBox x:Name="DiscoveredBrowsersListBox" Height="130" DisplayMemberPath="DisplayName" SelectionChanged="DiscoveredBrowsersListBox_OnSelectionChanged" />
                        <TextBlock Text="דפדפנים שאושרו:" Margin="0,12,0,4" />
                        <ListBox x:Name="ApprovedBrowsersListBox" Height="90" DisplayMemberPath="DisplayName" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="פרטי אישור הדפדפן:" />
                        <TextBox x:Name="BrowserDisplayNameBox" ToolTip="שם לתצוגה" />
                        <TextBox x:Name="BrowserPublisherBox" ToolTip="יצרן" FlowDirection="LeftToRight" />
                        <TextBox x:Name="BrowserProductBox" ToolTip="שם מוצר" FlowDirection="LeftToRight" />
                        <TextBox x:Name="BrowserPathBox" ToolTip="נתיב מלא לקובץ exe" FlowDirection="LeftToRight" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="הוסף אישור" Padding="12,6" Margin="0,4,6,4" Click="AddBrowserButton_OnClick" />
                            <Button Content="הסר נבחר" Padding="12,6" Margin="6,4,0,4" Click="RemoveBrowserButton_OnClick" />
                        </StackPanel>
                        <TextBlock Text="דפדפן שאושר תמיד ייפתח, גם ללא תוסף. אישור זה אינו חוסם חשבון Google בתוכו." Foreground="DarkOrange" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="לוח הזמנים" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ימים:" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ScheduleDaysBox" FlowDirection="LeftToRight" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="התחלה:" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ScheduleStartBox" FlowDirection="LeftToRight" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="סיום:" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ScheduleEndBox" FlowDirection="LeftToRight" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="פורמט ימים:" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Sunday, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday" FlowDirection="LeftToRight" />
                </Grid>
            </GroupBox>

            <GroupBox Header="מצבי דפדפן ועדכונים" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Guest וגלישה פרטית יופעלו רק כאשר אין חסימה רלוונטית או כאשר התוסף המנוהל זמין." />
                    <TextBlock Text="אישור דפדפן הוא אישור להפעלת הדפדפן בלבד ואינו עוקף חסימת אתר כלל־מחשבית." />
                    <TextBlock Text="ההגדרות נשמרות בנפרד מקובצי התוכנה כדי לאפשר עדכונים ללא הסרה." />
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SaveButton" Content="שמור הגדרות" Padding="18,8" Margin="8,0" Click="SaveButton_OnClick" />
                <Button Content="טען מחדש" Padding="18,8" Margin="8,0" Click="ReloadButton_OnClick" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="DarkGreen" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
