{
  "schemaVersion": 3,
  "websiteEnforcement": "AuditOnly",
  "blockUnknownGoogleSessionsDuringAccountSchedules": true,
  "guestModeAllowedWhenNoRelevantBlock": true,
  "safety": {
    "bootGraceSeconds": 120,
    "serviceGraceSeconds": 30,
    "maxActionsPerMinute": 20
  },
  "applications": [
    {
      "id": "example-rule-1",
      "name": "משחקים בלילה",
      "enabled": true,
