      "targets": [
        {
          "displayName": "Steam",
          "executablePath": "C:\\Program Files (x86)\\Steam\\steam.exe"
        }
      ],
      "windows": [
        {
          "enabled": true,
          "days": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday"],
          "start": "23:00",
          "end": "07:00",
          "allDay": false
        }
      ]
    }
  ],
  "googleAccounts": [
