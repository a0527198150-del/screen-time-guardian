      "sites": ["https://example-forum.com"],
      "windows": [
        {
          "enabled": true,
          "days": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday"],
          "start": "23:00",
          "end": "07:00",
          "allDay": false
        }
      ]
    }
  ],
